# Optional. Loaded from .env by the server; never commit real credentials.
# Copy to .env for local Qwen vision. No API key required.
QC_PROVIDER=ollama
QC_OLLAMA_BASE=http://127.0.0.1:11434
QC_OLLAMA_NUM_CTX=16384
QC_TIMEOUT_SEC=300
QC_MODEL=qwen3-vl:8b-instruct
QC_ENHANCED_MODEL=
QC_ENABLE_LIVE=1
# Alternatively use QC_PROVIDER=openai_compatible for an external HTTPS vision API.
QC_API_BASE=https://your-provider.example/v1
QC_API_KEY=
